{
    "name": "@vyapti/hiring",
    "version": "1.0.0",
    "description": "Client package for Intern Hiring Tracker stage actions and dashboard alerts",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "tsx --test src/__tests__/*.test.ts",
        "seed:intern-hiring": "tsx scripts/seed-intern-hiring.ts",
        "seed:intern-hiring:dry-run": "HIRING_SEED_DRY_RUN=true tsx scripts/seed-intern-hiring.ts --dry-run",

        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@vyapti/access-policy": "workspace:*",
        "@vyapti/auth": "workspace:*",
        "@vyapti/core": "workspace:*",
        "@vyapti/rbac": "workspace:*"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/swagger": "^11.0.0",
        "nestjs-zod": "^5.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/swagger": "^11.2.6",
        "@types/node": "^22.10.7",
        "nestjs-zod": "^5.3.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.7.3",
        "zod": "^4.4.3"
    }
}
